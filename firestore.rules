// ============================================================
//  Firestore Security Rules — Shield Environmental UST App
//  Deploy via Firebase Console → Firestore → Rules
//  or: firebase deploy --only firestore:rules
// ============================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: only the named admin may perform this action ──────────────────
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == 'robert_francis@shieldmw.com';
    }

    // ── Access requests ───────────────────────────────────────────────────────
    // Anyone (unauthenticated) may CREATE a request — that's the registration form.
    // Only the admin may READ, UPDATE, or DELETE requests.
    match /accessRequests/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ── Approved users ────────────────────────────────────────────────────────
    // Admin can read/write everything.
    // Each user may update ONLY their own lastSignIn field — nothing else.
    match /approvedUsers/{uid} {
      allow read, write: if isAdmin();
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['lastSignIn']);
    }

    // ── Deny everything else ──────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
