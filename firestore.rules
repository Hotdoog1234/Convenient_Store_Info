// ============================================================
//  Firestore Security Rules — Shield Environmental UST App
//  Deploy via Firebase Console → Firestore → Rules
//  or: firebase deploy --only firestore:rules
// ============================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: only the named admin may perform this action ──────────────────
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == 'robert_francis@shieldmw.com';
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    // ── Tank data — all authenticated users read, only admin writes ───────────
    match /tankData/{batchId} {
      allow read:  if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── Owner data — all authenticated users read, only admin writes ──────────
    match /ownerData/{batchId} {
      allow read:  if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── Metadata — all authenticated users read, only admin writes ────────────
    match /metadata/{docId} {
      allow read:  if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── Access requests ───────────────────────────────────────────────────────
    match /accessRequests/{id} {
      allow create: if true;
      allow read, write: if isAdmin();
    }

    // ── Approved users ────────────────────────────────────────────────────────
    match /approvedUsers/{uid} {
      allow read, write: if isAdmin();
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['lastSignIn']);
    }

    // ── Blocked users — users can read their own doc, only admin writes ──────
    match /blockedUsers/{uid} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow write: if isAdmin();
    }

    // ── Deny everything else ──────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
