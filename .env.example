# Copy this file to .env and fill in real values.
# .env is gitignored and must NEVER be committed.

# Firebase — from Firebase Console → Project Settings → Your apps
REACT_APP_FIREBASE_API_KEY=your_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id

# EmailJS — from emailjs.com dashboard
# NOTIFY template: sent to admin when someone requests access
#   Variables: {{requester_name}}, {{requester_email}}, {{to_email}}
# APPROVAL template: sent to user when approved
#   Variables: {{to_name}}, {{to_email}}, {{temp_password}}
# DENIAL template: sent to user when denied
#   Variables: {{to_name}}, {{to_email}}
REACT_APP_EMAILJS_SERVICE_ID=your_service_id
REACT_APP_EMAILJS_NOTIFY_TEMPLATE=your_notify_template_id
REACT_APP_EMAILJS_APPROVAL_TEMPLATE=your_approval_template_id
REACT_APP_EMAILJS_DENIAL_TEMPLATE=your_denial_template_id
REACT_APP_EMAILJS_PUBLIC_KEY=your_public_key
